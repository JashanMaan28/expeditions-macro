<UserControl x:Class="ExpeditionsMacro.App.Pages.MacroPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls">
    <Grid>
        <ScrollViewer x:Name="DashboardScroll"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Disabled"
                       SizeChanged="DashboardScroll_SizeChanged">
            <Grid x:Name="DashboardContentGrid"
                  Margin="26,20,26,28"
                  MaxWidth="1200"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="Dashboard" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" icons:Lucide.Icon="Play" Content="Start plan" ToolTip="Start the selected plan (F6)" Click="Start_Click" />
                        <Button x:Name="StopButton" Margin="8,0,0,0" Style="{StaticResource DangerButton}" icons:Lucide.Icon="Square" Content="Stop plan" ToolTip="Stop the running plan (F6)" IsEnabled="False" Click="Stop_Click" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="DashboardOverviewGrid"
                      Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="DashboardOverviewRowGap"
                                       Height="0" />
                        <RowDefinition x:Name="DashboardCurrentRunRow"
                                       Height="0" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="DashboardLiveViewColumn"
                                          Width="Auto" />
                        <ColumnDefinition x:Name="DashboardOverviewColumnGap"
                                          Width="16" />
                        <ColumnDefinition x:Name="DashboardCurrentRunColumn"
                                          Width="*"
                                          MinWidth="274" />
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="RobloxLiveViewCard"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Height="28">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource SectionTitle}" Text="Roblox live view" />
                                <CheckBox x:Name="PinRobloxCheck"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="True"
                                          Content="Pinned"
                                          Checked="PinRoblox_Changed"
                                          Unchecked="PinRoblox_Changed" />
                            </Grid>
                            <icons:RobloxDashboardPreview x:Name="RobloxPreview"
                                                          Grid.Row="1"
                                                          Margin="0,12,0,0"
                                                          ToolTip="The interactive Roblox window is pinned here while Dashboard is visible." />
                        </Grid>
                    </ContentControl>
                    <ContentControl x:Name="CurrentRunCard"
                                    Grid.Column="2"
                                    Style="{StaticResource SurfaceCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Current run" />
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <icons:StatusDot x:Name="RunStatusDot" Margin="0,6,9,0" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="PhaseText" FontSize="14" FontWeight="SemiBold" Text="Ready to run a saved plan." TextWrapping="Wrap" />
                                    <TextBlock x:Name="CurrentTaskText" Margin="0,4,0,0" Style="{StaticResource Caption}" Text="Current task: none" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2" Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <icons:StatTile x:Name="RuntimeTile"
                                                Grid.ColumnSpan="3"
                                                Style="{StaticResource StatTileLarge}"
                                                Label="RUNTIME"
                                                Value="00:00:00" />
                                <icons:StatTile x:Name="VictoriesTile"
                                                Grid.Row="2"
                                                Label="VICTORIES"
                                                Tone="Success"
                                                Value="0" />
                                <icons:StatTile x:Name="DefeatsTile"
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Label="DEFEATS"
                                                Tone="Error"
                                                Value="0" />
                            </Grid>
                            <Grid Grid.Row="3" Margin="0,16,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource GroupLabel}"
                                           Text="RUN LOG" />
                                <Border x:Name="RunLogViewport"
                                        Grid.Row="1"
                                        MinHeight="180"
                                        Margin="0,8,0,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        SnapsToDevicePixels="True">
                                    <icons:FillHeightDecorator>
                                        <TextBox x:Name="LogText"
                                                 IsReadOnly="True"
                                                 AcceptsReturn="True"
                                                 AutomationProperties.Name="Macro run log"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 TextWrapping="Wrap"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 Foreground="{DynamicResource MutedBrush}"
                                                 FontSize="12" />
                                    </icons:FillHeightDecorator>
                                </Border>
                            </Grid>
                            <ProgressBar x:Name="MacroProgress"
                                         Grid.Row="4"
                                         Margin="0,12,0,0"
                                         Visibility="Collapsed"
                                         Minimum="0"
                                         Maximum="100" />
                        </Grid>
                    </ContentControl>
                </Grid>

                <ContentControl Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Discord notifications" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Send run updates to a channel webhook and ping you when a run fails." />
                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="Webhook link" />
                        <Border Margin="0,7,0,0" Style="{StaticResource InputGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="WebhookPassword" Style="{StaticResource InputGroupPasswordBox}" />
                                <TextBox x:Name="WebhookVisible" Style="{StaticResource InputGroupTextBox}" Visibility="Collapsed" />
                                <Button x:Name="TestWebhookButton" Grid.Column="1" Height="32" Margin="4" icons:Lucide.Icon="Send" Content="Test webhook" Click="TestWebhook_Click" />
                                <CheckBox x:Name="ShowWebhookCheck" Grid.Column="2" Margin="4" Style="{StaticResource RevealToggle}" AutomationProperties.Name="Show webhook link" ToolTip="Show or hide webhook link" Checked="ShowWebhook_Changed" Unchecked="ShowWebhook_Changed" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="WebhookStatusText" Margin="0,8,0,0" Style="{StaticResource Caption}" />
                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldLabel}" Text="Discord user ID for failure pings" />
                        <TextBox x:Name="DiscordUserIdText" Margin="0,7,0,0" Width="340" HorizontalAlignment="Left" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Roblox reconnect" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Roblox can be relaunched through your private server automatically." />
                        <CheckBox x:Name="RestartRobloxAtStartCheck"
                                  Margin="0,14,0,0"
                                  Checked="PrivateServerRestartSetting_Changed"
                                  Content="Restart Roblox through this private server when a Macro plan starts"
                                  Unchecked="PrivateServerRestartSetting_Changed" />
                        <CheckBox x:Name="RestartRobloxCheck"
                                  Margin="0,14,0,0"
                                  Checked="PrivateServerRestartSetting_Changed"
                                  Content="Restart Roblox through this private server when recovery fails"
                                  Unchecked="PrivateServerRestartSetting_Changed" />
                        <TextBlock Margin="0,18,0,0" Style="{StaticResource FieldLabel}" Text="Private server link" />
                        <Border Margin="0,7,0,0" Style="{StaticResource InputGroup}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <PasswordBox x:Name="PrivateServerLinkPassword" Style="{StaticResource InputGroupPasswordBox}" />
                                <TextBox x:Name="PrivateServerLinkVisible" Style="{StaticResource InputGroupTextBox}" Visibility="Collapsed" />
                                <Button x:Name="TestPrivateServerButton" Grid.Column="1" Height="32" Margin="4" icons:Lucide.Icon="ExternalLink" Content="Test link" Click="TestPrivateServer_Click" />
                                <CheckBox x:Name="ShowPrivateServerLinkCheck" Grid.Column="2" Margin="4" Style="{StaticResource RevealToggle}" AutomationProperties.Name="Show private server link" ToolTip="Show or hide private server link" Checked="ShowPrivateServerLink_Changed" Unchecked="ShowPrivateServerLink_Changed" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="PrivateServerStatusText" Margin="0,7,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Macro preparation" />
                        <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Checks run once before each plan so the game matches what the macro expects." />
                        <CheckBox x:Name="DashboardAutoUiScaleCheck"
                                  Margin="0,14,0,0"
                                  Content="Check and fix UI Scale at macro start"
                                  ToolTip="When enabled, the macro directly measures the in-game UI Scale from Settings and corrects it when needed."
                                  Checked="DashboardAutoUiScaleCheck_Changed"
                                  Unchecked="DashboardAutoUiScaleCheck_Changed" />
                        <CheckBox x:Name="DashboardAutoGameSettingsCheck"
                                  Margin="0,12,0,0"
                                  Content="Check and fix required game settings at macro start"
                                  ToolTip="When enabled, the macro verifies and corrects the required Gameplay, Graphics, Units, and Misc settings."
                                  Checked="DashboardAutoGameSettingsCheck_Changed"
                                  Unchecked="DashboardAutoGameSettingsCheck_Changed" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Row="5" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <icons:SettingsKeyBindingsPanel x:Name="DashboardKeyBindingsPanel" />
                </ContentControl>
            </Grid>
        </ScrollViewer>

        <ScrollViewer x:Name="PlanScroll"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,20,26,28"
                  MaxWidth="1000"
                  HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,18">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource PageTitle}" Text="Macro Plan" />
                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <icons:StatusDot x:Name="PlanAutoSaveDot"
                                         Width="8"
                                         Height="8"
                                         Margin="0,1,7,0"
                                         VerticalAlignment="Center"
                                         Visibility="Collapsed" />
                        <TextBlock x:Name="PlanAutoSaveText"
                                   VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Grid>

                <ContentControl Grid.Row="1" Style="{StaticResource SurfaceCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabel}" FontSize="12" Text="Saved plan" />
                        <TextBlock Grid.Column="2" Style="{StaticResource FieldLabel}" FontSize="12" Text="Name" />
                        <ComboBox x:Name="PlanCombo" Grid.Row="1" Margin="0,6,0,0" DisplayMemberPath="Name" SelectionChanged="PlanCombo_SelectionChanged" />
                        <TextBox x:Name="PlanNameText"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Margin="0,6,0,0"
                                 Text="Daily rotation"
                                 TextChanged="PlanNameText_TextChanged" />
                        <StackPanel Grid.Row="1"
                                    Grid.Column="3"
                                    Margin="10,6,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <Button icons:Lucide.Icon="Plus"
                                    Content="New"
                                    MinWidth="76"
                                    Click="NewPlan_Click" />
                            <Button x:Name="DeletePlanButton"
                                    Margin="8,0,0,0"
                                    Height="32"
                                    MinWidth="0"
                                    Style="{StaticResource DangerButton}"
                                    icons:Lucide.Icon="Trash2"
                                    Content="Delete"
                                    ToolTip="Delete the selected saved plan"
                                    Click="DeletePlan_Click" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

                <ContentControl Grid.Row="2" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource SectionTitle}"
                                       Text="Plan blocks" />
                            <StackPanel HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <Button x:Name="ResetProgressButton"
                                        Style="{StaticResource GhostButton}"
                                        icons:Lucide.Icon="RotateCcw"
                                        Content="Reset progress"
                                        Click="ResetProgress_Click" />
                                <Button x:Name="AddLoopBlockButton"
                                        Margin="8,0,0,0"
                                        icons:Lucide.Icon="Workflow"
                                        Content="Add loop"
                                        Click="AddLoopBlock_Click" />
                                <Button x:Name="OpenTaskEditorButton"
                                        Height="32"
                                        MinWidth="108"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        icons:Lucide.Icon="Plus"
                                        Content="Add task"
                                        Click="OpenTaskEditor_Click" />
                            </StackPanel>
                        </Grid>

                        <icons:MacroPlanLoopEditor x:Name="LoopEditor"
                                                   Margin="0,8,0,0" />

                        <ItemsControl x:Name="TaskRowsControl"
                                      Visibility="Collapsed" />
                        <TextBlock x:Name="EmptyTasksText"
                                   Margin="0,8"
                                   Style="{StaticResource Caption}"
                                   Text="No blocks yet. Use Add task or Add loop above." />

                        <TextBlock x:Name="PlanBlocksStatusText"
                                   Margin="0,7,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </ContentControl>

                <ContentControl x:Name="SharePlanCard" Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource SurfaceCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Share config" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource Caption}" Text="Export this plan as a code, or paste a code from someone else to import it." />
                        </StackPanel>
                        <TextBox x:Name="ShareCodeText" Grid.Row="1" Height="64" Margin="0,12,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="SharePlanStatusText" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button x:Name="ExportPlanCodeButton" icons:Lucide.Icon="Send" Content="Export code" Click="ExportPlanCode_Click" />
                                <Button x:Name="CopyPlanCodeButton" Margin="8,0,0,0" icons:Lucide.Icon="Copy" Content="Copy" Click="CopyPlanCode_Click" />
                                <Button x:Name="ImportPlanCodeButton" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" icons:Lucide.Icon="FolderOpen" Content="Import code" Click="ImportPlanCode_Click" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ContentControl>
            </Grid>
        </ScrollViewer>

        <Grid x:Name="TaskEditorOverlay"
              Panel.ZIndex="20"
              Background="{DynamicResource ModalScrimBrush}"
              FocusManager.IsFocusScope="True"
              KeyboardNavigation.TabNavigation="Cycle"
              PreviewKeyDown="TaskEditorOverlay_PreviewKeyDown"
              Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="Visibility" Value="Visible">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <icons:MacroTaskEditorDialog x:Name="TaskEditorDialog"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         RenderTransformOrigin="0.5,0.5">
                <icons:MacroTaskEditorDialog.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </icons:MacroTaskEditorDialog.RenderTransform>
                <icons:MacroTaskEditorDialog.Style>
                    <Style TargetType="icons:MacroTaskEditorDialog">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=TaskEditorOverlay}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.98" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.98" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </icons:MacroTaskEditorDialog.Style>
            </icons:MacroTaskEditorDialog>
        </Grid>
    </Grid>
</UserControl>
