<UserControl x:Class="ExpeditionsMacro.App.Pages.ManualRecordingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls">
    <Grid Margin="28,22,32,26"
          MaxWidth="980"
          HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}"
                       Text="Manual recordings" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="14"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSurface}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <icons:LucideIcon Width="18"
                                  Height="18"
                                  VerticalAlignment="Top"
                                  Foreground="{DynamicResource WarningBrush}"
                                  Icon="CircleHelp" />
                <StackPanel Grid.Column="1">
                    <TextBlock FontWeight="SemiBold"
                               Text="Start on the confirmed prestart screen" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Text="The recording must click Start Game and stop before Victory or Defeat appears. Camera detection is paused for the entire recording and playback. Roblox must remain foreground at the standard 808 by 611 client size." />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSurface}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="Saved recordings" />
                        <TextBlock x:Name="RecordingCountText"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource Caption}"
                                   Text="0 recordings" />
                    </Grid>
                    <ListBox x:Name="RecordingsList"
                             Grid.Row="2"
                             AutomationProperties.Name="Saved recordings"
                             SelectionMode="Single"
                             SelectionChanged="RecordingsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40" Margin="2,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="Medium"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0"
                                                   Style="{StaticResource MonoCaption}"
                                                   Text="{Binding Detail}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="14,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MonoCaption}"
                                               Text="{Binding Created}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyRecordingsText"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource EmptyStateTile}">
                            <icons:LucideIcon Width="28"
                                              Height="28"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Foreground="{DynamicResource FaintBrush}"
                                              Icon="CircleDot" />
                        </Border>
                        <TextBlock Style="{StaticResource EmptyStateTitle}" Text="No recordings yet" />
                        <TextBlock Style="{StaticResource EmptyStateCaption}" Text="Name a recording, then arm it to capture a route with the macro hotkey." />
                    </StackPanel>
                    <TextBlock x:Name="PlaybackStatusText"
                               Grid.Row="4"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Caption}"
                               Text="Select a recording to test."
                               TextWrapping="Wrap" />
                    <StackPanel Grid.Row="6"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="TestRecordingButton"
                                AutomationProperties.Name="Arm selected recording playback"
                                icons:Lucide.Icon="CircleDot"
                                Content="Arm playback"
                                Click="TestRecording_Click" />
                        <Button x:Name="DeleteRecordingButton"
                                Margin="8,0,0,0"
                                Style="{StaticResource DangerButton}"
                                icons:Lucide.Icon="Trash2"
                                Content="Delete"
                                Click="DeleteRecording_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusSurface}"
                    SnapsToDevicePixels="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}"
                               Text="New recording" />
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource FieldLabel}"
                               Text="Name" />
                    <TextBox x:Name="RecordingNameText"
                             Margin="0,6,0,0"
                             MaxLength="120"
                             Text="New route recording" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Text="With this page open, the global macro hotkey starts recording immediately and presses it again to stop and save." />
                    <Button x:Name="StartRecordingButton"
                            Margin="0,16,0,0"
                            Style="{StaticResource PrimaryButton}"
                            icons:Lucide.Icon="CircleDot"
                            Content="Arm recording"
                            Click="StartRecording_Click" />
                    <TextBlock x:Name="RecordingStatusText"
                               Margin="0,14,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Text="Ready." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
