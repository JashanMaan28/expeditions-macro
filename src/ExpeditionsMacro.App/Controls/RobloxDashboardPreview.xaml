<UserControl x:Class="ExpeditionsMacro.App.Controls.RobloxDashboardPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
             Loaded="Preview_Loaded"
             Unloaded="Preview_Unloaded">
    <Border HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#050506"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True"
            SnapsToDevicePixels="True">
        <Grid x:Name="PinTarget"
              Width="808"
              Height="611"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <StackPanel x:Name="PlaceholderPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Style="{StaticResource EmptyStateTile}">
                    <icons:LucideIcon Width="28"
                                      Height="28"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource FaintBrush}"
                                      Icon="ScanSearch" />
                </Border>
                <TextBlock Style="{StaticResource EmptyStateTitle}"
                           Foreground="#F2F3F5"
                           Text="Live view" />
                <TextBlock x:Name="PreviewStatusText"
                           Style="{StaticResource EmptyStateCaption}"
                           Foreground="#A6A9AE"
                           Text="Waiting for Roblox." />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
