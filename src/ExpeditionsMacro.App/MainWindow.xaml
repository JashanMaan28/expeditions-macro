<Window x:Class="ExpeditionsMacro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:ExpeditionsMacro.App.Controls"
        Title="Expeditions Macro"
        Icon="Resources/app.ico"
        Style="{StaticResource AppWindow}"
        Width="1200" Height="780" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource CanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseRightButtonUp="TitleBar_RightClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleNavigationColumn"
                                      Width="216" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <StackPanel x:Name="BrandContent"
                                Margin="14,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Image Width="23"
                               Height="23"
                               Margin="0,0,9,0"
                               Source="Resources/app-preview.png" />
                        <TextBlock x:Name="BrandWordmark"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource BrandFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="Expeditions Macro" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="TitleContextRow" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="3"
                             Height="3"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource FaintBrush}" />
                    <TextBlock x:Name="TitleContext" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}" Text="Dashboard" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" icons:Lucide.Icon="Minus" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" icons:Lucide.Icon="Square" ToolTip="Maximize" Click="Maximize_Click" />
                    <Button Style="{StaticResource TitleBarCloseButton}" icons:Lucide.Icon="X" ToolTip="Close" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="UpdateBanner"
                Grid.Row="1"
                Margin="12,10,12,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSurface}"
                SnapsToDevicePixels="True"
                Visibility="Collapsed">
            <Border BorderBrush="{DynamicResource InnerHairlineBrush}"
                    BorderThickness="{DynamicResource InnerHairlineThickness}"
                    CornerRadius="{StaticResource RadiusSurfaceInner}"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Margin="0,8"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="1.5"
                            SnapsToDevicePixels="True" />
                    <StackPanel Grid.Column="1" Margin="13,12,0,12" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateBannerTitle"
                                   FontWeight="SemiBold"
                                   Text="Application update available" />
                        <TextBlock x:Name="UpdateBannerDetail"
                                   Margin="0,3,18,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Text="Download the verified installer when you are ready."
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="UpdateBannerProgress"
                                     Height="3"
                                     Margin="0,8,18,0"
                                     Maximum="1"
                                     Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                                Margin="0,0,14,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="UpdateReleaseButton"
                                Height="28"
                                Margin="0,0,8,0"
                                icons:Lucide.Icon="ExternalLink"
                                Content="Release notes"
                                Click="UpdateRelease_Click" />
                        <Button x:Name="UpdatePrimaryButton"
                                Height="28"
                                MinWidth="104"
                                Style="{StaticResource PrimaryButton}"
                                icons:Lucide.Icon="Download"
                                Content="Download"
                                Click="UpdatePrimary_Click" />
                        <Button x:Name="UpdateCancelButton"
                                Height="28"
                                Margin="8,0,0,0"
                                Content="Cancel"
                                Visibility="Collapsed"
                                Click="UpdateCancel_Click" />
                        <Button Margin="8,0,0,0"
                                Style="{StaticResource IconButton}"
                                icons:Lucide.Icon="X"
                                ToolTip="Dismiss update notice"
                                Click="UpdateDismiss_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavigationColumn"
                                  Width="216" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="NavigationRail"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="WorkspaceHeaderRow"
                          Height="34"
                          Margin="10,10,10,7">
                        <TextBlock x:Name="WorkspaceHeader"
                                   Margin="8,0,44,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GroupLabel}"
                                   Text="WORKSPACE" />
                        <Button x:Name="NavigationRailToggleButton"
                                Width="32"
                                MinWidth="32"
                                Height="32"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconButton}"
                                icons:Lucide.Icon="Menu"
                                ToolTip="Collapse navigation"
                                AutomationProperties.Name="Collapse navigation"
                                Click="NavigationRailToggle_Click" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <RadioButton x:Name="DashboardNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" IsChecked="True" Tag="Dashboard" icons:Lucide.Icon="LayoutDashboard" Content="Dashboard" Checked="Navigation_Checked" />
                        <RadioButton x:Name="MacroPlanNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" Tag="Macro Plan" icons:Lucide.Icon="Blocks" Content="Macro Plan" Checked="Navigation_Checked" />
                        <TextBlock x:Name="ToolsHeader"
                                   Margin="20,16,20,6"
                                   Style="{StaticResource GroupLabel}"
                                   Text="TOOLS" />
                        <RadioButton x:Name="PlacementNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" Tag="Placement Setup" icons:Lucide.Icon="MapPin" Content="Placement Setup" Checked="Navigation_Checked" />
                        <RadioButton x:Name="RecordingsNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" Tag="Recordings" icons:Lucide.Icon="CircleDot" Content="Recordings" Visibility="Collapsed" Checked="Navigation_Checked" />
                        <RadioButton x:Name="DebugNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" Tag="Debug" icons:Lucide.Icon="Bug" Content="Debug" Visibility="Collapsed" Checked="Navigation_Checked" />
                        <RadioButton x:Name="SettingsNav" GroupName="Navigation" Style="{StaticResource NavigationItem}" Tag="Settings" icons:Lucide.Icon="Settings" Content="Settings" Checked="Navigation_Checked" />
                    </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <Button x:Name="SetupGuideButton"
                                Margin="12,0,12,4"
                                Height="30"
                                MinWidth="0"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                icons:Lucide.Icon="CircleHelp"
                                Content="Setup guide"
                                ToolTip="Open the setup guide in your browser"
                                Click="SetupGuide_Click" />
                        <Button x:Name="JoinDiscordButton"
                                Margin="12,0,12,8"
                                Height="30"
                                MinWidth="0"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                icons:Lucide.Icon="MessagesSquare"
                                Content="Join Discord"
                                ToolTip="Open the Expeditions Macro community invite"
                                Click="JoinDiscord_Click" />
                        <Border x:Name="OperationStatusBorder"
                                Margin="12,0,12,6"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSurface}"
                                SnapsToDevicePixels="True">
                            <Border x:Name="OperationStatusInner"
                                    Padding="10"
                                    BorderBrush="{DynamicResource InnerHairlineBrush}"
                                    BorderThickness="{DynamicResource InnerHairlineThickness}"
                                    CornerRadius="{StaticResource RadiusSurfaceInner}"
                                    SnapsToDevicePixels="True">
                                <Grid x:Name="OperationStatusContent">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel x:Name="OperationSummary"
                                                Orientation="Horizontal">
                                        <icons:StatusDot x:Name="OperationDot" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="OperationLabel" MaxWidth="150" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="Medium" Text="Ready" />
                                    </StackPanel>
                                    <TextBlock x:Name="OperationRuntime"
                                               Grid.Row="1"
                                               Margin="16,5,0,0"
                                               Style="{StaticResource MonoCaption}"
                                               Foreground="{DynamicResource FaintBrush}"
                                               Text="00:00:00"
                                               Visibility="Collapsed" />
                                    <StackPanel x:Name="HotkeyHint"
                                                Grid.Row="2"
                                                Margin="16,6,0,0"
                                                Orientation="Horizontal">
                                        <ContentControl x:Name="HotkeyChip" Style="{StaticResource KbdChip}" Content="F6" />
                                        <TextBlock x:Name="HotkeyHintLabel"
                                                   Margin="7,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource FaintBrush}"
                                                   Text="start / stop" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                        <TextBlock x:Name="VersionLabel" Margin="18,0,18,10" HorizontalAlignment="Center" Foreground="{DynamicResource FaintBrush}" FontSize="10" Text="Version" />
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Column="1" />
        </Grid>
    </Grid>
</Window>
