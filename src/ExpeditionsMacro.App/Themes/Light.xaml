<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="CanvasColor">#FAFAFB</Color>
    <Color x:Key="SidebarColor">#F4F5F6</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="RaisedColor">#F0F1F3</Color>
    <Color x:Key="HoverColor">#0A000000</Color>
    <Color x:Key="SelectedColor">#12000000</Color>
    <Color x:Key="BorderColor">#E4E5E8</Color>
    <Color x:Key="BorderStrongColor">#D2D4D8</Color>
    <Color x:Key="InnerHairlineColor">#0A000000</Color>
    <Color x:Key="TextColor">#1A1C1F</Color>
    <Color x:Key="MutedColor">#565A60</Color>
    <Color x:Key="FaintColor">#6A6E74</Color>
    <Color x:Key="AccentColor">#535EE6</Color>
    <Color x:Key="AccentHoverColor">#4750D6</Color>
    <Color x:Key="AccentPressedColor">#3D46C4</Color>
    <Color x:Key="AccentStrongColor">#535EE6</Color>
    <Color x:Key="AccentStrongHoverColor">#4750D6</Color>
    <Color x:Key="AccentStrongPressedColor">#3D46C4</Color>
    <Color x:Key="AccentSoftColor">#1F535EE6</Color>
    <Color x:Key="OnAccentColor">#FFFFFF</Color>
    <Color x:Key="SuccessColor">#1E7A52</Color>
    <Color x:Key="WarningColor">#8D6814</Color>
    <Color x:Key="ErrorColor">#B13E48</Color>
    <Color x:Key="SuccessSoftColor">#171E7A52</Color>
    <Color x:Key="WarningSoftColor">#178D6814</Color>
    <Color x:Key="ErrorSoftColor">#17B13E48</Color>
    <Color x:Key="ScrollThumbColor">#26000000</Color>
    <Color x:Key="ScrollThumbHoverColor">#3D000000</Color>
    <Color x:Key="MatchStepReconfigureColor">#2F7887</Color>
    <Color x:Key="MatchStepUpgradeColor">#7650B4</Color>
    <Thickness x:Key="InnerHairlineThickness">0,0,0,1</Thickness>
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="InnerHairlineBrush" Color="{StaticResource InnerHairlineColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="{StaticResource AccentStrongColor}" />
    <SolidColorBrush x:Key="AccentStrongHoverBrush" Color="{StaticResource AccentStrongHoverColor}" />
    <SolidColorBrush x:Key="AccentStrongPressedBrush" Color="{StaticResource AccentStrongPressedColor}" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#0F535EE6" />
    <SolidColorBrush x:Key="AccentInnerHairlineBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
    <SolidColorBrush x:Key="ModalScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="MatchStepPlacementBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="MatchStepReconfigureBrush" Color="{StaticResource MatchStepReconfigureColor}" />
    <SolidColorBrush x:Key="MatchStepStartBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="MatchStepDelayBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="MatchStepUpgradeBrush" Color="{StaticResource MatchStepUpgradeColor}" />
</ResourceDictionary>
