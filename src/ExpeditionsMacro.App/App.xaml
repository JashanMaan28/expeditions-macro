<Application x:Class="ExpeditionsMacro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Typography.xaml" />
                <ResourceDictionary Source="Themes/Metrics.xaml" />
                <ResourceDictionary Source="Themes/Controls.Buttons.xaml" />
                <ResourceDictionary Source="Themes/Controls.Inputs.xaml" />
                <ResourceDictionary Source="Themes/Controls.Chrome.xaml" />
                <ResourceDictionary Source="Themes/Controls.Feedback.xaml" />
                <ResourceDictionary Source="Themes/PlacementEditor.xaml" />
                <ResourceDictionary Source="Themes/Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
